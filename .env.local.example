# Copy this file to .env.local and fill in your real key.
# NEVER commit .env.local, and NEVER expose OPENAI_API_KEY to the browser
# (do not prefix it with NEXT_PUBLIC_).

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Text generation model used for the tutor's replies (Responses API).
CHAT_MODEL=gpt-6-luna

# Speech-to-text model used to transcribe the child's recording.
TRANSCRIBE_MODEL=gpt-transcribe

# Text-to-speech model + voice used to speak the tutor's reply.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral

# Very small MVP daily usage cap, in minutes, per session/child.
DAILY_LIMIT_MINUTES=15

# Persistence (see lib/db.ts). Defaults to a local SQLite file - no account
# needed. To move to hosted Turso later, set these two to the DB's
# libsql://... URL and auth token from the Turso dashboard; no code changes
# needed.
# DATABASE_URL=file:./data/app.db
# DATABASE_AUTH_TOKEN=
